# Copy to .env and fill in. Never commit .env.

# Choose a provider: anthropic (Claude) or gemini (Google AI Studio)
AI_PROVIDER=anthropic

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: comma list of models to rotate to when the primary is overloaded
# ANTHROPIC_FALLBACK_MODELS=claude-haiku-5-5

# --- Google Gemini (free tier has small per-minute and per-day request limits) ---
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.5-flash
# AI_FALLBACK_MODELS=gemini-3-flash-preview

# --- Optional tuning (all providers) ---
AI_MAX_RETRIES=5
AI_REQUEST_DELAY_SECONDS=2
# Minimum seconds between requests. Defaults: 1 for Claude, 13 for Gemini free tier.
# AI_MIN_INTERVAL_SECONDS=1
AI_TIMEOUT_SECONDS=120
AI_CONCURRENCY=3
# AI_TEMPERATURE=0.2
# Reuse identical AI responses between runs (set AI_CACHE=0 to disable)
# AI_CACHE=1
