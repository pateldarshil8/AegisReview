# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: comma list of models to rotate to when the primary is overloaded
# ANTHROPIC_FALLBACK_MODELS=claude-haiku-5-5

# Optional tuning
AI_MAX_RETRIES=5
AI_REQUEST_DELAY_SECONDS=2
# Minimum seconds between requests
# AI_MIN_INTERVAL_SECONDS=1
AI_TIMEOUT_SECONDS=120
AI_CONCURRENCY=3
# Reuse identical AI responses between runs (set AI_CACHE=0 to disable)
# AI_CACHE=1
