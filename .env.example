# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.5-flash
# Optional: comma list of models to rotate to when the primary is overloaded
# AI_FALLBACK_MODELS=gemini-3-flash-preview

# Optional tuning
AI_MAX_RETRIES=5
AI_REQUEST_DELAY_SECONDS=2
# Free tier allows ~5 requests/minute; keep spacing at or above 13s
AI_MIN_INTERVAL_SECONDS=13
AI_TIMEOUT_SECONDS=120
AI_CONCURRENCY=3
# AI_TEMPERATURE=0.2
# Reuse identical AI responses between runs (set AI_CACHE=0 to disable)
# AI_CACHE=1
# AI_MAX_OUTPUT_TOKENS=32768
